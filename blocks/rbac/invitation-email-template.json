  "templateBody": "<!doctype html><html><body style=\"margin:0;padding:0;background:#f4f2f8;font-family:Arial,Helvetica,sans-serif;color:#242638\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f2f8;padding:32px 16px\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border:1px solid #e8e4ef;border-radius:12px;padding:36px 32px\"><tr><td><p style=\"margin:0 0 8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#7a7190\">Atlas access</p><h1 style=\"margin:0 0 18px;font-size:26px;line-height:1.3;color:#3b2d6b\">You're invited</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#4a4458\">You have been invited to <strong>{{Organization}}</strong>.</p><p style=\"margin:0 0 8px;font-size:15px;line-height:1.7;color:#4a4458\"><strong>Scope:</strong> {{Unit}}</p><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#4a4458\"><strong>Role:</strong> {{Role}}</p><p style=\"margin:0 0 28px\"><a href=\"{{InvitationUrl}}\" style=\"display:inline-block;background:#5b3cc4;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:700\">Activate your account</a></p><p style=\"margin:0 0 12px;font-size:13px;line-height:1.7;color:#6f6783\">Open the link to activate your Blocks account with this email address, then sign in and accept the invitation to receive your role.</p><p style=\"margin:0;font-size:12px;line-height:1.7;color:#8a8299\">This invitation expires after seven days. If you were not expecting it, you can ignore this email.</p></td></tr></table></td></tr></table></body></html>"
